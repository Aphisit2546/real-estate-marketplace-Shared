{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": [".next/**", "!.next/cache/**", "dist/**"], "env": ["NEXT_PUBLIC_*", "API_BASE_URL", "WEB_URL", "SITE_URL"] },
    "typecheck": { "dependsOn": ["^typecheck"] },
    "lint": {},
    "test": { "cache": false },
    "dev": { "cache": false, "persistent": true }
  }
}
